<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 5 %}
        style="max-height: 13rem; overflow-y: auto;"
      {% endif %}
    >
      <table class="table table-sm table-borderless mb-0">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td class="text-truncate" style="max-width: 1px">
              {% case item.category %}
                {% when 'position' %}
                  <i class="fa-solid fa-user-plus" title="open position"></i>
                {% when 'publication' %}
                  <i class="fa-solid fa-file-lines" title="new publication"></i>
                {% when 'talk' %}
                  <i class="fa-solid fa-chalkboard-user" title="talk/seminar"></i>
              {% endcase %}
              {% if include.limit %}
                <a
                  href="#"
                  class="news-title"
                  data-toggle="modal"
                  data-target="#news-modal-{{ forloop.index0 }}"
                  onclick="event.preventDefault()"
                >
                  {% if item.title %}
                    {{ item.title }}
                  {% else %}
                    {{ item.content | strip_html | strip_newlines | truncate: 90 }}
                  {% endif %}
                </a>
              {% elsif item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
  <p class="text-muted mt-2 mb-0" style="font-size: 0.9rem">
    I am always interested in motivated M2 and PhD applications, feel free to get in touch.
  </p>
</div>

{% if include.limit and site.news != blank %}
  {% assign news = site.news | reverse %}
  {% for item in news %}
    <div class="modal fade" id="news-modal-{{ forloop.index0 }}" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">{% if item.title %}{{ item.title }}{% endif %}</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <p class="text-muted">{{ item.date | date: '%B %d, %Y' }}</p>
            {% if item.inline %}
              {{ item.content | emojify }}
            {% else %}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
{% endif %}
